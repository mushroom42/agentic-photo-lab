{
  "name": "agentic-photo-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A controlled domain for evaluating reliable agentic coding under complex constraints.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build --silent && node --test dist/tests/*.test.js",
    "demo": "npm run build --silent && node dist/src/demo.js",
    "benchmark": "npm run build --silent && node dist/src/run-benchmark.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
